@model DotnetProject.Web.Models.DeploymentRecord

@{
    ViewData["Title"] = "Delete Deployment Record";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card p-4 shadow-sm border-danger">
            <h3 class="fw-bold text-danger mb-3">
                <i class="bi bi-exclamation-triangle me-2"></i>Delete Deployment Record?
            </h3>
            <p class="text-secondary">Are you sure you want to permanently remove this release record from the deployment tracker?</p>

            <div class="p-3 bg-dark rounded border border-secondary mb-4">
                <div class="mb-2"><strong>Application:</strong> <span class="text-primary">@Model.AppName</span></div>
                <div class="mb-2"><strong>Version:</strong> <code>@Model.Version</code></div>
                <div class="mb-2"><strong>Environment:</strong> @Model.Environment</div>
                <div><strong>Deployed At:</strong> @Model.DeployedAt.ToString("yyyy-MM-dd HH:mm UTC")</div>
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i> Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
