@model IEnumerable<DotnetProject.Web.Models.DeploymentRecord>

@{
    ViewData["Title"] = "Deployment Releases";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-light mb-1">
            <i class="bi bi-stack text-primary me-2"></i>Release Records
        </h2>
        <p class="text-secondary mb-0">Track all deployed artifacts, environments, and CI/CD results.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Log New Deployment
        </a>
    </div>
</div>

<!-- Quick Stats Bar -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card p-3 shadow-sm border-0 bg-dark">
            <div class="text-secondary small">Total Releases</div>
            <h3 class="fw-bold text-light mb-0">@(ViewBag.TotalCount ?? 0)</h3>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card p-3 shadow-sm border-0 bg-dark">
            <div class="text-secondary small">Successful Deployments</div>
            <h3 class="fw-bold text-success mb-0">@(ViewBag.SuccessCount ?? 0)</h3>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card p-3 shadow-sm border-0 bg-dark">
            <div class="text-secondary small">Production Deployments</div>
            <h3 class="fw-bold text-info mb-0">@(ViewBag.ProdCount ?? 0)</h3>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card p-3 mb-4">
    <form method="get" class="row g-3 align-items-center">
        <div class="col-auto">
            <label class="col-form-label text-secondary small">Environment:</label>
        </div>
        <div class="col-auto">
            <select name="envFilter" class="form-select form-select-sm bg-dark text-light border-secondary">
                <option value="">All Environments</option>
                <option value="Production" selected="@(ViewBag.CurrentEnv == "Production")">Production</option>
                <option value="Staging" selected="@(ViewBag.CurrentEnv == "Staging")">Staging</option>
                <option value="Development" selected="@(ViewBag.CurrentEnv == "Development")">Development</option>
            </select>
        </div>
        <div class="col-auto">
            <label class="col-form-label text-secondary small">Status:</label>
        </div>
        <div class="col-auto">
            <select name="statusFilter" class="form-select form-select-sm bg-dark text-light border-secondary">
                <option value="">All Statuses</option>
                <option value="Successful" selected="@(ViewBag.CurrentStatus == "Successful")">Successful</option>
                <option value="Failed" selected="@(ViewBag.CurrentStatus == "Failed")">Failed</option>
                <option value="In-Progress" selected="@(ViewBag.CurrentStatus == "In-Progress")">In-Progress</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-outline-primary">Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="card shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark border-bottom border-secondary">
                <tr>
                    <th>Application</th>
                    <th>Version</th>
                    <th>Environment</th>
                    <th>Status</th>
                    <th>Deployed By</th>
                    <th>Commit</th>
                    <th>Date (UTC)</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold text-light">
                            <i class="bi bi-box-seam me-1 text-primary"></i>@item.AppName
                        </td>
                        <td>
                            <code class="text-info">@item.Version</code>
                        </td>
                        <td>
                            @if (item.Environment == "Production")
                            {
                                <span class="badge badge-env-prod">Production</span>
                            }
                            else if (item.Environment == "Staging")
                            {
                                <span class="badge badge-env-staging">Staging</span>
                            }
                            else
                            {
                                <span class="badge badge-env-dev">@item.Environment</span>
                            }
                        </td>
                        <td>
                            @if (item.Status == "Successful")
                            {
                                <span class="badge badge-status-success"><i class="bi bi-check-circle me-1"></i>Success</span>
                            }
                            else if (item.Status == "Failed")
                            {
                                <span class="badge badge-status-failed"><i class="bi bi-x-circle me-1"></i>Failed</span>
                            }
                            else
                            {
                                <span class="badge badge-status-pending"><i class="bi bi-hourglass-split me-1"></i>@item.Status</span>
                            }
                        </td>
                        <td class="small text-secondary">@item.DeployedBy</td>
                        <td>
                            <span class="badge bg-dark border border-secondary text-secondary font-monospace">@item.CommitHash</span>
                        </td>
                        <td class="small text-secondary">@item.DeployedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1" title="Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center py-5 text-secondary">
                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                        No deployment records found. <a asp-action="Create" class="text-primary">Create one now</a>.
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
