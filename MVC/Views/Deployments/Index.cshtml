@model IEnumerable<DotnetProject.Core.Entities.DeploymentRecord>

@{
    ViewData["Title"] = "Deployment Releases";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold text-white mb-0">
                <i class="bi bi-stack text-primary me-2"></i>Release Records
            </h2>
            <span class="badge badge-soft-cyan">Relational DB</span>
        </div>
        <p class="text-secondary mb-0">Track all deployed artifacts, target environments, and automated CI/CD pipeline telemetry.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-glass" data-bs-toggle="modal" data-bs-target="#webhookModal">
            <i class="bi bi-code-square me-1 text-warning"></i> CI Webhook cURL
        </button>
        <a asp-action="Create" class="btn btn-primary-gradient">
            <i class="bi bi-plus-lg me-1"></i> Log Release
        </a>
    </div>
</div>

<!-- Quick Stats Bar -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card card-glass p-3 h-100 stat-card">
            <div class="text-secondary small text-uppercase fw-semibold">Total Releases</div>
            <h3 class="fw-bold text-light mb-0 mt-1">@(ViewBag.TotalCount ?? 0)</h3>
            <i class="bi bi-layers stat-icon text-primary"></i>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card card-glass p-3 h-100 stat-card">
            <div class="text-secondary small text-uppercase fw-semibold">Successful Deployments</div>
            <h3 class="fw-bold text-success mb-0 mt-1">@(ViewBag.SuccessCount ?? 0)</h3>
            <i class="bi bi-check-circle stat-icon text-success"></i>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card card-glass p-3 h-100 stat-card">
            <div class="text-secondary small text-uppercase fw-semibold">Production Releases</div>
            <h3 class="fw-bold text-cyan-accent mb-0 mt-1">@(ViewBag.ProdCount ?? 0)</h3>
            <i class="bi bi-cloud-check stat-icon text-info"></i>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card card-glass p-3 mb-4">
    <form method="get" class="row g-3 align-items-center">
        <div class="col-auto">
            <label class="col-form-label text-secondary small fw-medium">Environment:</label>
        </div>
        <div class="col-auto">
            <select name="envFilter" class="form-select form-select-sm bg-dark text-light border-secondary">
                <option value="">All Environments</option>
                <option value="Production" selected="@(ViewBag.CurrentEnv == "Production")">Production</option>
                <option value="Staging" selected="@(ViewBag.CurrentEnv == "Staging")">Staging</option>
                <option value="Development" selected="@(ViewBag.CurrentEnv == "Development")">Development</option>
            </select>
        </div>
        <div class="col-auto">
            <label class="col-form-label text-secondary small fw-medium">Status:</label>
        </div>
        <div class="col-auto">
            <select name="statusFilter" class="form-select form-select-sm bg-dark text-light border-secondary">
                <option value="">All Statuses</option>
                <option value="Successful" selected="@(ViewBag.CurrentStatus == "Successful")">Successful</option>
                <option value="Failed" selected="@(ViewBag.CurrentStatus == "Failed")">Failed</option>
                <option value="In-Progress" selected="@(ViewBag.CurrentStatus == "In-Progress")">In-Progress</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-primary-gradient px-3">Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-glass px-3">Reset</a>
        </div>
    </form>
</div>

<!-- Releases Table -->
<div class="card card-glass overflow-hidden">
    <div class="table-responsive">
        <table class="table table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Application</th>
                    <th>Version</th>
                    <th>Environment</th>
                    <th>Status</th>
                    <th>Deployed By</th>
                    <th>Commit</th>
                    <th>Date (UTC)</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="p-1 rounded bg-primary bg-opacity-25 text-primary">
                                    <i class="bi bi-box-seam"></i>
                                </span>
                                <div>
                                    <div class="fw-semibold text-white">@item.AppName</div>
                                    @if (item.Project != null)
                                    {
                                        <span class="badge badge-soft-cyan py-0" style="font-size: 0.7rem;">@item.Project.Name</span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>
                            <code class="text-info font-mono">@item.Version</code>
                        </td>
                        <td>
                            @if (item.Environment == "Production")
                            {
                                <span class="badge badge-soft-danger px-2 py-1 rounded-pill">Production</span>
                            }
                            else if (item.Environment == "Staging")
                            {
                                <span class="badge badge-soft-warning px-2 py-1 rounded-pill">Staging</span>
                            }
                            else
                            {
                                <span class="badge badge-soft-cyan px-2 py-1 rounded-pill">@item.Environment</span>
                            }
                        </td>
                        <td>
                            @if (item.Status == "Successful")
                            {
                                <span class="badge badge-soft-success px-2 py-1 rounded-pill d-inline-flex align-items-center gap-1">
                                    <span class="pulse-indicator" style="width: 6px; height: 6px;"></span> Success
                                </span>
                            }
                            else if (item.Status == "Failed")
                            {
                                <span class="badge badge-soft-danger px-2 py-1 rounded-pill">
                                    <i class="bi bi-x-circle me-1"></i>Failed
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-soft-warning px-2 py-1 rounded-pill">
                                    <i class="bi bi-hourglass-split me-1"></i>@item.Status
                                </span>
                            }
                        </td>
                        <td class="small text-secondary">
                            <i class="bi bi-person me-1"></i>@item.DeployedBy
                        </td>
                        <td>
                            <span class="badge bg-dark border border-secondary text-secondary font-mono">
                                @(string.IsNullOrEmpty(item.CommitHash) ? "manual" : item.CommitHash)
                            </span>
                        </td>
                        <td class="small text-secondary font-mono">
                            @item.DeployedAt.ToString("yyyy-MM-dd HH:mm")
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-glass text-info me-1" title="Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-glass text-warning me-1" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-glass text-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center py-5 text-secondary">
                        <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                        No deployment records found. <a asp-action="Create" class="text-primary">Create one now</a>.
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<!-- CI/CD Webhook Modal -->
<div class="modal fade" id="webhookModal" tabindex="-1" aria-labelledby="webhookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content card-glass border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white" id="webhookModalLabel">
                    <i class="bi bi-send text-primary me-2"></i>Post Release via CI/CD Webhook
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-secondary small">
                    Use this cURL command in your GitHub Actions, GitLab CI, or Jenkins pipelines to automatically record deployments in the Release Tracker:
                </p>
                <div class="p-3 rounded bg-dark border border-secondary font-mono text-info small mb-3">
                    curl -X POST "http://localhost/api/deployments/webhook" \<br/>
                    &nbsp;&nbsp;-H "Content-Type: application/json" \<br/>
                    &nbsp;&nbsp;-d '{<br/>
                    &nbsp;&nbsp;&nbsp;&nbsp;"repository": "dotnet-devops-release-tracker",<br/>
                    &nbsp;&nbsp;&nbsp;&nbsp;"releaseVersion": "v2.0.0",<br/>
                    &nbsp;&nbsp;&nbsp;&nbsp;"environment": "Production",<br/>
                    &nbsp;&nbsp;&nbsp;&nbsp;"status": "Successful",<br/>
                    &nbsp;&nbsp;&nbsp;&nbsp;"commitSha": "'$GITHUB_SHA'",<br/>
                    &nbsp;&nbsp;&nbsp;&nbsp;"actor": "'$GITHUB_ACTOR'",<br/>
                    &nbsp;&nbsp;&nbsp;&nbsp;"summary": "Automated deployment executed via CI/CD pipeline."<br/>
                    &nbsp;&nbsp;}'
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-secondary small">Also accessible via OpenAPI specification:</span>
                    <a href="/swagger" target="_blank" class="btn btn-sm btn-glass text-warning">
                        Open Swagger UI &rarr;
                    </a>
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-sm btn-glass" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
