@{
    ViewData["Title"] = "DevOps CI/CD Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card p-4 border-0 shadow-sm" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border-left: 5px solid #3b82f6 !important;">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h2 class="fw-bold text-light mb-1">
                        <i class="bi bi-rocket-takeoff text-primary me-2"></i>DevOps Deployment Tracker
                    </h2>
                    <p class="text-secondary mb-0">
                        ASP.NET Core 8.0 MVC application automated via GitHub Actions CI/CD to AWS EC2 (systemd + Nginx) with MySQL persistence.
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Deployments" asp-action="Create" class="btn btn-primary px-3">
                        <i class="bi bi-plus-lg me-1"></i> Log Deployment
                    </a>
                    <a asp-controller="Deployments" asp-action="Index" class="btn btn-outline-light px-3">
                        <i class="bi bi-table me-1"></i> View All Records
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card p-3 shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-secondary small text-uppercase fw-semibold">Continuous Integration</div>
                    <h4 class="fw-bold text-light my-1">GitHub Actions</h4>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                        <i class="bi bi-check2 me-1"></i> Automated xUnit Tests Gate
                    </span>
                </div>
                <div class="text-primary stat-icon">
                    <i class="bi bi-git"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-secondary small text-uppercase fw-semibold">Compute & Hosting</div>
                    <h4 class="fw-bold text-light my-1">AWS EC2 Linux</h4>
                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                        <i class="bi bi-hdd-network me-1"></i> systemd + Kestrel (:5000)
                    </span>
                </div>
                <div class="text-info stat-icon">
                    <i class="bi bi-ubuntu"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-secondary small text-uppercase fw-semibold">Database Engine</div>
                    <h4 class="fw-bold text-light my-1">MySQL Database</h4>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                        <i class="bi bi-database-check me-1"></i> EF Core Pomelo Provider
                    </span>
                </div>
                <div class="text-warning stat-icon">
                    <i class="bi bi-database"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card p-4 shadow-sm h-100">
            <h5 class="fw-bold text-light mb-3">
                <i class="bi bi-diagram-3 text-primary me-2"></i>Architectural Evolution Roadmap
            </h5>
            <div class="timeline">
                <div class="p-3 mb-3 rounded" style="background: rgba(59, 130, 246, 0.1); border-left: 3px solid #3b82f6;">
                    <div class="d-flex justify-content-between">
                        <strong class="text-primary">Phase 1: ASP.NET Core MVC (Current)</strong>
                        <span class="badge bg-primary">Active</span>
                    </div>
                    <p class="small text-secondary mt-1 mb-0">
                        Monolithic MVC application with direct Entity Framework Core access, integrated Razor UI, automated xUnit tests, and complete GitHub Actions CI/CD to AWS EC2.
                    </p>
                </div>
                <div class="p-3 mb-3 rounded" style="background: rgba(245, 158, 11, 0.1); border-left: 3px solid #f59e0b;">
                    <div class="d-flex justify-content-between">
                        <strong class="text-warning">Phase 2: Decoupled REST Web API Tier</strong>
                        <span class="badge bg-secondary">Upcoming</span>
                    </div>
                    <p class="small text-secondary mt-1 mb-0">
                        Extract business logic into a dedicated REST API service project (`DotnetProject.Api`), enabling webhook endpoints for external CI tools and 3rd party clients.
                    </p>
                </div>
                <div class="p-3 rounded" style="background: rgba(16, 185, 129, 0.1); border-left: 3px solid #10b981;">
                    <div class="d-flex justify-content-between">
                        <strong class="text-success">Phase 3: Dedicated Data Access Layer (3-Tier)</strong>
                        <span class="badge bg-secondary">Upcoming</span>
                    </div>
                    <p class="small text-secondary mt-1 mb-0">
                        Full physical separation into Presentation Tier (Web/Mobile), Business Logic / API Tier, and Data Access Layer (`DotnetProject.Data`) with repository patterns.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card p-4 shadow-sm h-100">
            <h5 class="fw-bold text-light mb-3">
                <i class="bi bi-activity text-danger me-2"></i>DevOps Health Status
            </h5>
            <div class="d-flex flex-column gap-3">
                <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-2">
                    <span class="text-secondary">Health Endpoint:</span>
                    <a href="/health" class="btn btn-sm btn-outline-info" target="_blank">
                        <code>GET /health</code>
                    </a>
                </div>
                <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-2">
                    <span class="text-secondary">Runtime:</span>
                    <span class="text-light fw-medium">.NET 8.0 LTS Kestrel</span>
                </div>
                <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-2">
                    <span class="text-secondary">Service Daemon:</span>
                    <span class="badge bg-dark border border-secondary text-secondary">systemd (Linux)</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-secondary">Quick Action:</span>
                    <a asp-controller="Deployments" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        Browse Releases &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
