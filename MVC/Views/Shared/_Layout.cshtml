<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevOps Cloud Release Tracker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DotnetProject.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4 shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="d-inline-flex align-items-center justify-content-center p-2 rounded-3" style="background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);">
                        <i class="bi bi-cloud-arrow-up-fill text-white fs-5"></i>
                    </span>
                    <span class="bg-gradient text-white">DevOps Tracker</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2 me-1 text-primary"></i> Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Deployments" asp-action="Index"><i class="bi bi-stack me-1 text-info"></i> Releases</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/swagger" target="_blank"><i class="bi bi-file-earmark-code me-1 text-warning"></i> Swagger API</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/api/health" target="_blank"><i class="bi bi-heart-pulse me-1 text-danger"></i> API Health</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-dark border border-secondary" style="font-size: 0.82rem;">
                            <span class="pulse-indicator"></span>
                            <span class="text-light fw-medium">Phase 2: Decoupled API</span>
                        </div>
                        <span class="badge badge-soft-primary px-3 py-2 rounded-pill d-none d-md-inline-block">
                            <i class="bi bi-shield-check me-1"></i> systemd sandbox
                        </span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-3 bg-dark border-top border-secondary text-secondary" style="font-size: 0.85rem;">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <span>&copy; 2026 - <strong>ASP.NET Core 8.0 Decoupled Architecture</strong> &bull; Nginx Path Routing &bull; MySQL 8.0</span>
            <span class="text-muted">
                <i class="bi bi-cpu me-1"></i> systemd <code class="text-info">DynamicUser=yes</code> &bull; <a href="/health" class="text-secondary text-decoration-underline" target="_blank">Health Status</a>
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
