[Unit]
Description=ASP.NET Core REST API Service (DevOps Release Tracker API)
After=network.target

[Service]
WorkingDirectory=/var/www/dotnetapi
ExecStart=/usr/bin/dotnet /var/www/dotnetapi/DotnetProject.Api.dll
Restart=always
# Restart service after 10 seconds if dotnet service crashes
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnetapi
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://127.0.0.1:5050
# Load database connection and secrets from secure server-only environment file
EnvironmentFile=-/etc/dotnetapp.env

# Container-grade Linux Kernel isolation & sandboxing
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
